# Stage 1: Build dependency wheel artifacts
FROM python:3.11.8-slim-bookworm AS builder
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Hardened, unprivileged production runtime
FROM python:3.11.8-slim-bookworm AS runner
WORKDIR /app

# Create dedicated non-root security service account
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /sbin/nologin -d /app appuser

# Copy installed dependencies and application code
COPY --from=builder /root/.local /home/appuser/.local
COPY --chown=appuser:appgroup app.py .

# Enforce non-root execution
USER 10001:10001

# Restrict exposed endpoints to unprivileged application port
EXPOSE 8080

# Configure automated container health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["python", "app.py"]
